# ==========================================
# Auralytics Backend .gitignore
# ==========================================

# Environment variables & secrets (never commit live API keys)
.env
.env.*
*.env
!.env.example
!*.env.example

# Credentials & key material
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json
service-account*.json

# Python virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Bytecode & Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing, type checking & linting
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Local databases & dumps (never commit SQLite DBs or dumps)
*.db
*.sqlite
*.sqlite3
*.db-journal
influenceos.db
postgres-data/
pgdata/
*.sql.gz
*.dump

# Logs
*.log
*.log.*
logs/

# IDE & Editor settings
.vscode/
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
.history/

# Temporary / OS files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
