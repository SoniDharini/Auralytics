# InfluenceOS Backend Environment Configuration Example
PROJECT_NAME="InfluenceOS API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (PostgreSQL with asyncpg, or fallback SQLite for testing)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/influenceos"
# SQLite alternative for local offline testing:
# DATABASE_URL="sqlite+aiosqlite:///./influenceos.db"

# JWT Authentication
JWT_SECRET_KEY="super-secret-key-change-in-production-influenceos-auth-secret-key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie Settings
REFRESH_COOKIE_NAME="influenceos_refresh_token"
COOKIE_SECURE=False
COOKIE_SAMESITE="lax"

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
