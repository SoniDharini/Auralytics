# InfluenceOS Backend Environment Configuration Example
PROJECT_NAME="InfluenceOS API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (Native PostgreSQL with asyncpg)
# Include the postgres user password: postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/influenceos
# Or run ../setup_local_postgres.ps1 once (Administrator) to set a local password and rewrite this line.
DATABASE_URL="postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/influenceos"
# SQLite alternative for local offline testing:
# DATABASE_URL="sqlite+aiosqlite:///./influenceos.db"

# JWT Authentication
JWT_SECRET_KEY="super-secret-key-change-in-production-influenceos-auth-secret-key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie Settings
REFRESH_COOKIE_NAME="influenceos_refresh_token"
COOKIE_SECURE=False
COOKIE_SAMESITE="lax"

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# External Social Providers Configuration
# YouTube Data API v3 (Get your key from Google Cloud Console)
YOUTUBE_API_KEY=""
# Max creators enriched and persisted per discovery run
YOUTUBE_DISCOVERY_MAX_CREATORS=50
# Each search costs 100 quota units of the 10,000/day default allowance
YOUTUBE_MAX_SEARCH_QUERIES=5
YOUTUBE_SEARCH_RESULTS_PER_QUERY=15
# Recent uploads sampled per creator to derive average views/likes/comments
YOUTUBE_RECENT_VIDEO_SAMPLE=8
# Max ranked recommendations returned after filtering
DISCOVERY_FINAL_RESULT_LIMIT=20

# Meta / Instagram Graph API Configuration (Optional)
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_API_VERSION="v19.0"

# Creator Cache TTL (hours)
INFLUENCER_CACHE_TTL_HOURS=6

# Groq Cloud (backend only — never put this in VITE_* or the frontend)
# Create a key at https://console.groq.com/keys
# Selected model from Groq org limits: openai/gpt-oss-120b (general chat, not prompt-guard)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_REQUEST_TIMEOUT=60
AI_MAX_RETRIES=2
