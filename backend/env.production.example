# Production values for the API EC2 microservice. Terraform writes these to SSM.
# Do not commit real secrets.

PROJECT_NAME=Auralytics API
ENVIRONMENT=production
DEBUG=false

DATABASE_URL=postgresql+asyncpg://auralytics:CHANGE_ME@YOUR_RDS_HOST:5432/auralytics
DATABASE_SSL=true

JWT_SECRET_KEY=generate-a-long-random-secret
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://YOUR_ALB_DNS

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
YOUTUBE_API_KEY=
