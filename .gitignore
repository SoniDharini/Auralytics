# ==========================================
# InfluenceOS .gitignore
# ==========================================

# Environment variables & secrets (never commit real keys)
.env
.env.*
!.env.example
!**/.env.example
*.env
!*.env.example
backend/.env
frontend/.env
*.env.local
*.env.development
*.env.test
*.env.production
*.env.development.local
*.env.test.local
*.env.production.local
.envrc

# Credentials & key material
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json
service-account*.json
**/secrets/

# Python Virtual Environments
venv/
.venv/
env/
ENV/
backend/venv/
backend/env/
backend/.venv/
frontend/venv/
env.bak/
venv.bak/

# Python Bytecode & Cache
__pycache__/
**/__pycache__/
*.py[cod]
**/*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Testing & Coverage
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
.ruff_cache/
.dmypy.json
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
.vite/
dist/
dist-ssr/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.eslintcache
.stylelintcache
.turbo/
.cache/

# PostgreSQL Standalone Binaries & Data
pgsql/
pgsql/data/
pgsql/bin/
pgsql/lib/
pgsql/share/
pgsql/include/
*.log
*.log.*
pg.log
logfile
logfile.log

# Database files & local dumps
*.db
*.sqlite
*.sqlite3
*.db-journal
*.sql.gz
*.dump
influenceos.db
backend/*.db
backend/*.sqlite3
postgres-data/
pgdata/

# IDE & Editor Configs
.vscode/
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
.history/
*.sublime-workspace
*.sublime-project

# AI Agent & IDE artifacts
.gemini/
.system_generated/
scratch/
.agent/
.cursor/

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
Desktop.ini
