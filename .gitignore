# ==========================================
# InfluenceOS .gitignore
# ==========================================

# Environment variables & secrets
.env
.env.*
!.env.example
*.env
backend/.env
frontend/.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# Python Virtual Environments
venv/
.venv/
env/
ENV/
backend/venv/
backend/env/
backend/.venv/
frontend/venv/
env.bak/
venv.bak/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
.vite/
dist/
dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.eslintcache
.stylelintcache
.turbo/

# PostgreSQL Standalone Binaries & Data
pgsql/
pgsql/data/
pgsql/bin/
pgsql/lib/
pgsql/share/
pgsql/include/
*.log
*.log.*
pg.log
logfile
logfile.log

# Database files
*.db
*.sqlite
*.sqlite3
*.db-journal
influenceos.db
backend/*.db
backend/*.sqlite3

# IDE & Editor Configs
.vscode/
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
.history/
*.sublime-workspace
*.sublime-project

# AI Agent & IDE artifacts
.gemini/
.system_generated/
scratch/
.agent/

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
Desktop.ini
